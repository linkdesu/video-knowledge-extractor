{
  "name": "video-notes",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "design:prototype": "bun .omp/skills/verify-video-notes/scripts/verify.ts prototype",
    "install:local": "bun run apps/desktop/scripts/install-local.ts",
    "test": "turbo run test && bun run test:tools",
    "test:tools": "bun test ./.omp/skills/verify-video-notes/scripts",
    "typecheck": "turbo run typecheck && bun run typecheck:tools",
    "typecheck:tools": "tsc --noEmit -p .omp/skills/verify-video-notes/scripts/tsconfig.json",
    "verify:detect": "bun .omp/skills/verify-video-notes/scripts/verify.ts detect",
    "verify:packaged-launch": "bun .omp/skills/verify-video-notes/scripts/packaged-launch.ts",
    "vnote": "bun run apps/cli/src/cli.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "turbo": "^2.10.5",
    "typescript": "^7.0.2"
  }
}
