{
  "name": "@video-notes/desktop",
  "version": "0.1.12",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package:mac": "bun run build && bun scripts/package-mac.ts",
    "package:win": "bun run build && bun scripts/package-win.ts",
    "fetch:ffmpeg": "bun scripts/fetch-ffmpeg.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "bun test --passWithNoTests",
    "rbp:vendor": "bun scripts/vendor-reactbits.ts",
    "install:local": "bun scripts/install-local.ts"
  },
  "dependencies": {
    "@video-notes/core": "workspace:*",
    "sherpa-onnx-node": "1.13.8"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
